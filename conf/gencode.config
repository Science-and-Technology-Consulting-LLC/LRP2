/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Merge the GENCODE references, then auto-set params
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    // Merge GENCODE references into params.genomes (GENCODE takes precedence if there are conflicts)
    genomes = (params.genomes ?: [:]) + (params.gencode_refs ?: [:])

    // Priority: (1) if both --local_reference_gtf and --local_reference_fasta are given, they are used and --genome is ignored;
    // (2) otherwise --genome picks the GENCODE release from gencode_refs.
    // Species comes from --species with local references, and from the genome name otherwise.
    gtf = params.local_reference_gtf && params.local_reference_fasta ?
        params.local_reference_gtf :
        (params.genomes && params.genome && params.genomes.containsKey(params.genome) ? params.genomes[params.genome].gtf : null)

    fasta = params.local_reference_gtf && params.local_reference_fasta ?
        params.local_reference_fasta :
        (params.genomes && params.genome && params.genomes.containsKey(params.genome) ? params.genomes[params.genome].fasta : null)

    species = params.local_reference_gtf && params.local_reference_fasta ?
        params.species :
        (params.genomes && params.genome && params.genomes.containsKey(params.genome) ?
            (params.genome.startsWith('GRCm') ? 'mouse' : 'human') : params.species)
}
