// Parameters. Sample data comes in through --input (a CSV of S3 paths); everything else is a setting.
params {

    // Input
    input                      = null      // sample sheet CSV: sample_name, sample_path, condition, sample_type
    dataset_name               = 'lrp2'    // prefix for merged output files
    outdir                     = 'results' // relative to the job results on Lifebit

    // Optional inputs that skip earlier steps
    S2_custom_gtf              = null      // called isoforms GTF from another caller (skips S1)
    S2_custom_counts           = null      // transcript count matrix to go with S2_custom_gtf
    S4_multisample_metadata    = null      // multisample-only mode: sample sheet CSV
    S4_custom_gtf              = null      // multisample-only mode: filtered transcripts GTF from a previous run
    S4_custom_counts           = null      // multisample-only mode: filtered transcript counts from a previous run
    S4_custom_orf_counts       = null      // multisample-only mode: collapsed ORF counts from a previous run
    sample_metadata            = null      // sample metadata CSV (defaults to the sample sheet)

    // Reference: --genome (a GENCODE key from conf/gencode_references.config) or both local_reference_* files
    genome                     = 'GRCh38.p14.v50'
    local_reference_gtf        = null
    local_reference_fasta      = null
    species                    = null      // human or mouse; set automatically from --genome

    // Images built from container/ by .github/workflows/docker-publish.yml and tagged by commit SHA, never latest
    image_registry             = 'ghcr.io/science-and-technology-consulting-llc/lrp2'
    image_tag                  = 'cf6f9d3209eef1a31959c52471b71ae43de08624'

    // S1 alignment
    s1_alignment_threads         = null
    s1_alignment_sorting_threads = null

    // S2 transcriptome filters
    protein_coding_filter      = true
    internal_priming_filter    = true
    template_switching_filter  = true
    percent_polya_threshold    = 60
    transcript_class_keep      = 'FSM,ISM,NIC,NNC'

    // S3 predicted proteome
    min_orf                        = 75
    top_orf                        = 5
    cpat_coding_threshold          = null  // human 0.364, mouse 0.44 when null
    min_junctions_after_stop_codon = 0
    protein_class_keep             = 'FPM,NPC,NPE'

    // S4 multisample analysis
    min_samples_per_intron     = 2
    min_samples_per_group      = 2
    min_usage_ratio            = 0.01
    drimseq_min_gene_expr      = 10
    drimseq_min_isoform_prop   = 0.05
    leafcutter_threads         = 12

    // S5 proteomics (modules are in place, not wired in main.nf yet)
    msconvert_peak_picking     = true
    fragpipe_decoy_tag         = 'rev_'
    fragpipe_threads           = null
    fragpipe_tools_dir         = null

    publish_dir_mode           = 'copy'
    help                       = false
    trace_report_suffix        = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

// Docker is on by default: Lifebit (AWS Batch) supplies executor, queue and work directory.
docker.enabled = true

// GENCODE reference table and the logic that turns --genome into gtf, fasta and species
includeConfig 'conf/gencode_references.config'
includeConfig 'conf/gencode.config'

process {
    cpus          = 1
    memory        = { 6.GB  * task.attempt }
    time          = { 4.h   * task.attempt }
    cache         = 'lenient'
    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: process_single      { cpus = 1;  memory = { 6.GB   * task.attempt }; time = { 1.h * task.attempt } }
    withLabel: process_low         { cpus = 1;  memory = { 16.GB  * task.attempt }; time = { 1.h * task.attempt } }
    withLabel: process_medium      { cpus = 1;  memory = { 48.GB  * task.attempt }; time = { 2.h * task.attempt } }
    withLabel: process_high        { cpus = 16; memory = { 128.GB * task.attempt }; time = { 3.h * task.attempt } }
    withLabel: process_long        { cpus = 1;  memory = { 32.GB  * task.attempt }; time = { 8.h * task.attempt } }
    withLabel: process_high_memory { cpus = 12; memory = { 500.GB * task.attempt }; time = { 8.h * task.attempt } }

    withName: 'ISOCALL_CALL'    { cpus = 12; memory = { 5.GB * task.attempt }; time = { 1.h * task.attempt } }
    withName: 'ISOCALL_PROFILE' { cpus = 4 }
}

// Bash options for every task
process.shell = ['bash', '-C', '-e', '-u', '-o', 'pipefail']

// Keep local R and Python libraries out of the containers
env {
    PYTHONNOUSERSITE = 1
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html" }

manifest {
    name            = 'Science-and-Technology-Consulting-LLC/LRP2'
    description     = 'Long-read proteogenomics: Iso-Seq to filtered transcripts, predicted proteome and differential splicing'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=24.04.2'
    version         = '1.0.0dev'
}

// Where each process publishes
includeConfig 'conf/modules.config'
